{
  "manifest_version": 3,
  "name": "Chess Analyzer",
  "version": "1.2",
  "description": "Öffnet chess.com-Partien im Analyse-Tool — per Popup oder direkt per Button im Game-Over-Fenster",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": ["*://*.chess.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Im Analyse-Tool öffnen",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.chess.com/*"],
      "js": ["settings.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
